# Copier en .env puis remplir ce qui est utile. Ne jamais committer .env.

# --- Générateur ---
# Gemma 4 via un serveur compatible « chat completions » (Ollama, vLLM, fournisseur cloud)
KERNEL_LLM_BASE_URL=
KERNEL_LLM_MODEL=
KERNEL_LLM_API_KEY=
# Secours si Gemma est absent ou injoignable : local (défaut dans docker compose) ou vide
KERNEL_LLM_FALLBACK=local
# Forcer le générateur local (1) ou le workflow de démo fixe (KERNEL_LLM_MOCK=1)
KERNEL_LLM_LOCAL=
KERNEL_LLM_MOCK=

# --- Connecteurs (exécution réelle uniquement) ---
KERNEL_TELEGRAM_TOKEN=
KERNEL_GMAIL_USER=
KERNEL_GMAIL_APP_PASSWORD=
